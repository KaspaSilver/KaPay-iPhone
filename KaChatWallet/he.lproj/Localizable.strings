"Gives this account a name of your own." = "נותן לחשבון הזה שם משלכם.";
"Removes this account and its local data from this device." = "מסיר את החשבון הזה ואת הנתונים המקומיים שלו מהמכשיר הזה.";
"Deletes %@ (%@) and its local data from this device." = "מוחק את %@ (%@) ואת הנתונים המקומיים שלו מהמכשיר הזה.";
"Record a buy or a sell by hand." = "רישום ידני של קנייה או מכירה.";
"Track an address's balance as part of this portfolio." = "מעקב אחרי יתרה של כתובת כחלק מתיק ההשקעות הזה.";
"Import & Export" = "ייבוא וייצוא";
"Read transactions in from a file." = "קריאת עסקאות מקובץ.";
"Write this portfolio's transactions out to a file." = "כתיבת העסקאות של תיק ההשקעות הזה לקובץ.";
"Delete 1 Transaction?" = "למחוק עסקה אחת?";
"Delete %lld Transactions?" = "למחוק %lld עסקאות?";
